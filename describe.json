{
  "id": "bot-memory",
  "name": "记忆 Bot 模板",
  "description": "在 Persona 层面复现五层长期记忆(事实库/知识库/反思/人格/档案 + 三级底座 + 混合检索),记忆归 bot 私有,经系统前缀注入、对话实时沉淀。工具与 cortico-world-memory 同源。",
  "version": "0.1.0",
  "kind": "bot",
  "api": 7,
  "author": "hth768",
  "license": "MIT",
  "homepage": "https://github.com/hth768/cortico-extensions",
  "repository": "git+https://github.com/hth768/cortico-extensions.git",
  "keywords": ["cortico-bot", "cortico-kit", "memory", "memory-management", "agent-memory", "bm25"],
  "tools": [
    { "name": "mem_remember", "description": "把值得长期记住的事写进记忆库(事实库去重重排 + 向量索引,之后 mem_recall 可语义找回)。", "parameters": { "type": "object", "additionalProperties": false, "properties": { "text": { "type": "string", "title": "内容" }, "scope": { "type": "string", "title": "记忆域" } }, "required": ["text"] }, "tags": ["write"] },
    { "name": "mem_recall", "description": "按语义+关键词混合检索长期记忆(scope 留空/填 main = 跨全部域;可填 qq:<QQ号>)。", "parameters": { "type": "object", "additionalProperties": false, "properties": { "query": { "type": "string", "title": "查询" }, "top_k": { "type": "number", "title": "条数" }, "scope": { "type": "string", "title": "记忆域" } }, "required": ["query"] }, "tags": ["read"] },
    { "name": "mem_recent", "description": "回看本域最近短期对话。", "parameters": { "type": "object", "additionalProperties": false, "properties": { "n": { "type": "number", "title": "条数" }, "scope": { "type": "string", "title": "记忆域" } }, "required": [] }, "tags": ["read", "snapshot"] },
    { "name": "mem_overflow", "description": "短期记忆快满时取出最旧的一半条目,便于压缩进 mem_summary。", "parameters": { "type": "object", "additionalProperties": false, "properties": { "scope": { "type": "string", "title": "记忆域" } }, "required": [] }, "tags": ["act"] },
    { "name": "mem_summary", "description": "读或写本域的对话摘要。", "parameters": { "type": "object", "additionalProperties": false, "properties": { "text": { "type": "string", "title": "摘要内容" }, "scope": { "type": "string", "title": "记忆域" } }, "required": [] }, "tags": ["read", "write"] },
    { "name": "mem_topic", "description": "读或写当前话题。", "parameters": { "type": "object", "additionalProperties": false, "properties": { "text": { "type": "string", "title": "话题内容" }, "scope": { "type": "string", "title": "记忆域" } }, "required": [] }, "tags": ["read", "write"] },
    { "name": "mem_note", "description": "记一条重要信息(硬约束/偏好),常驻进系统前缀。", "parameters": { "type": "object", "additionalProperties": false, "properties": { "text": { "type": "string", "title": "内容" }, "scope": { "type": "string", "title": "记忆域" } }, "required": ["text"] }, "tags": ["write"] },
    { "name": "mem_notes", "description": "列出本域全部重要信息及编号。", "parameters": { "type": "object", "additionalProperties": false, "properties": { "scope": { "type": "string", "title": "记忆域" } }, "required": [] }, "tags": ["read"] },
    { "name": "mem_forget_note", "description": "按编号(1起)删除一条重要信息。", "parameters": { "type": "object", "additionalProperties": false, "properties": { "index": { "type": "number", "title": "编号" }, "scope": { "type": "string", "title": "记忆域" } }, "required": ["index"] }, "tags": ["write"] },
    { "name": "mem_knowledge", "description": "沉淀一条通用知识(主题+要点+关键词,同主题合并去重)。", "parameters": { "type": "object", "additionalProperties": false, "properties": { "topic": { "type": "string", "title": "主题" }, "facts": { "type": "string", "title": "要点(换行分隔)" }, "keywords": { "type": "string", "title": "关键词" }, "sources": { "type": "string", "title": "来源" } }, "required": ["topic", "facts"] }, "tags": ["write"] },
    { "name": "mem_knowledge_fact", "description": "把单条知识直接记进知识库(自动提炼关键词)。", "parameters": { "type": "object", "additionalProperties": false, "properties": { "content": { "type": "string", "title": "知识内容" } }, "required": ["content"] }, "tags": ["write"] },
    { "name": "mem_knowledge_recall", "description": "回答问题前先查知识库,命中则直接复用。", "parameters": { "type": "object", "additionalProperties": false, "properties": { "query": { "type": "string", "title": "查询" }, "top_k": { "type": "number", "title": "条数" } }, "required": ["query"] }, "tags": ["read"] },
    { "name": "mem_knowledge_list", "description": "列出知识库主题数量。", "parameters": { "type": "object", "additionalProperties": false, "properties": { "limit": { "type": "number", "title": "条数" } }, "required": [] }, "tags": ["read"] },
    { "name": "mem_reflect", "description": "沉淀一条反思/交互偏好/纠错;可执行的提炼为交互规则。", "parameters": { "type": "object", "additionalProperties": false, "properties": { "content": { "type": "string", "title": "内容" }, "type": { "type": "string", "title": "类型" }, "evidence": { "type": "string", "title": "证据" }, "user_id": { "type": "string", "title": "用户ID" }, "confidence": { "type": "number", "title": "置信度" }, "actionable": { "type": "number", "title": "可执行" } }, "required": ["content", "type"] }, "tags": ["write"] },
    { "name": "mem_reflect_rules", "description": "列出已沉淀的交互规则。", "parameters": { "type": "object", "additionalProperties": false, "properties": { "user_id": { "type": "string", "title": "用户ID" } }, "required": [] }, "tags": ["read"] },
    { "name": "mem_persona", "description": "记录某用户的独特相处模式(特征+风格,去重上限20)。", "parameters": { "type": "object", "additionalProperties": false, "properties": { "user_id": { "type": "string", "title": "用户ID" }, "traits": { "type": "string", "title": "特征" }, "style": { "type": "string", "title": "风格" } }, "required": ["user_id", "traits"] }, "tags": ["write"] },
    { "name": "mem_persona_get", "description": "读取某用户人格记忆。", "parameters": { "type": "object", "additionalProperties": false, "properties": { "user_id": { "type": "string", "title": "用户ID" } }, "required": [] }, "tags": ["read"] },
    { "name": "mem_persona_global", "description": "设置/读取全局风格。", "parameters": { "type": "object", "additionalProperties": false, "properties": { "style": { "type": "string", "title": "全局风格" } }, "required": [] }, "tags": ["read", "write"] },
    { "name": "mem_profile", "description": "记/更新某用户人物档案(常驻前缀)。", "parameters": { "type": "object", "additionalProperties": false, "properties": { "user_id": { "type": "string", "title": "用户ID" }, "facts": { "type": "string", "title": "事实" } }, "required": ["user_id", "facts"] }, "tags": ["write"] },
    { "name": "mem_profile_replace", "description": "整体替换某用户人物档案(纠错)。", "parameters": { "type": "object", "additionalProperties": false, "properties": { "user_id": { "type": "string", "title": "用户ID" }, "facts": { "type": "string", "title": "事实" } }, "required": ["user_id", "facts"] }, "tags": ["write"] },
    { "name": "mem_profile_get", "description": "读取某用户人物档案。", "parameters": { "type": "object", "additionalProperties": false, "properties": { "user_id": { "type": "string", "title": "用户ID" } }, "required": [] }, "tags": ["read"] },
    { "name": "mem_stats", "description": "记忆库统计(域/条数/向量索引/向量来源)。", "parameters": { "type": "object", "additionalProperties": false, "properties": {}, "required": [] }, "tags": ["snapshot", "read"] },
    { "name": "mem_capture_now", "description": "立即落盘并报告状态(自动捕获为事件驱动)。", "parameters": { "type": "object", "additionalProperties": false, "properties": {}, "required": [] }, "tags": ["act"] },
    { "name": "mem_flush", "description": "立即落盘。", "parameters": { "type": "object", "additionalProperties": false, "properties": {}, "required": [] }, "tags": ["act"] },
    { "name": "mem_export", "description": "导出记忆(json/markdown/sqlite,遵循 cortico-memory-export 规范)。", "parameters": { "type": "object", "additionalProperties": false, "properties": { "format": { "type": "string", "title": "格式" }, "scope": { "type": "string", "title": "作用域" }, "outDir": { "type": "string", "title": "目录" } }, "required": [] }, "tags": ["act"] },
    { "name": "mem_import", "description": "迁入导出的记忆文件(默认 merge,可选 replace)。", "parameters": { "type": "object", "additionalProperties": false, "properties": { "path": { "type": "string", "title": "文件路径" }, "mode": { "type": "string", "title": "模式" } }, "required": ["path"] }, "tags": ["write", "act"] }
  ],
  "bot": {
    "worlds": [],
    "memory": { "title": "记忆" }
  }
}
